{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/events/canonical-event/v1",
  "title": "AEGIS Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "source_id", "event_type", "occurred_at", "observed_at", "source_confidence", "extraction_confidence", "schema_version"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "source_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "enum": ["FLOOD", "HEAVY_RAIN", "LANDSLIDE", "ROAD_CLOSURE", "INFRASTRUCTURE_FAILURE", "NORMAL"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "country": { "type": "string" },
        "district": { "type": "string" },
        "place_name": { "type": "string" }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string", "enum": ["LOCATION", "ORGANIZATION", "DATE", "INFRASTRUCTURE", "RIVER", "ROAD", "DISTRICT"] },
          "value": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "measurements": { "type": "object", "additionalProperties": { "type": "number" } },
    "severity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "source_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "raw_object_uri": { "type": ["string", "null"], "format": "uri-reference" },
    "schema_version": { "type": "string", "const": "event.v1" }
  }
}

